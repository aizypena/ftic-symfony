{% extends 'student/base.html.twig' %}

{% block title %}{{ course.name }} – FTIC Student{% endblock %}

{% block body %}

{% set totalSubmissions = 0 %}
{% for items in submissionsByWeek %}
    {% set totalSubmissions = totalSubmissions + (items|length) %}
{% endfor %}

<section class="mb-8 space-y-6">
    <div class="relative overflow-hidden rounded-3xl hero-banner hero-banner--admin-course px-8 py-8 text-white shadow-2xl"
         style="background-color:#0b3612;">
        <div class="absolute inset-0 opacity-25" style="background-image: radial-gradient(circle at 15% 15%, rgba(92,141,103,0.35), transparent 45%), radial-gradient(circle at 75% 0%, rgba(196,217,200,0.25), transparent 50%);"></div>
        <div class="relative flex flex-wrap items-start justify-between gap-6">
            <div class="space-y-3 max-w-3xl">
                <a href="{{ path('app_student_courses') }}" class="inline-flex items-center gap-1 text-xs text-emerald-100/80 hover:text-white transition">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Back to My Courses
                </a>
                <div class="space-y-1">
                    <p class="text-xs font-semibold uppercase tracking-[0.45em] text-emerald-200/80">Course Journey</p>
                    <h1 class="text-3xl font-semibold leading-tight">{{ course.name }}</h1>
                </div>
                {% if course.description %}
                    <p class="text-sm text-white/80">{{ course.description }}</p>
                {% endif %}
            </div>
            <div class="flex flex-col items-end gap-3 text-sm text-white/80">
                <span class="inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-semibold shadow-sm"
                      style="background-color:rgba(255,255,255,0.15);">
                    <span class="h-1.5 w-1.5 rounded-full" style="background-color:{% if course.status == 'active' %}#bbf7d0{% else %}#fee2e2{% endif %};"></span>
                    {{ course.status|capitalize }}
                </span>
                {% if course.professor %}
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center text-base font-semibold text-white">
                            {{ course.professor.displayName|first|upper }}
                        </div>
                        <div class="text-right">
                            <p class="text-xs uppercase tracking-[0.25em] text-white/60">Professor</p>
                            <p class="text-sm font-semibold text-white">{{ course.professor.displayName }}</p>
                        </div>
                    </div>
                {% endif %}
                {% if course.term %}
                    <div class="text-right">
                        <p class="text-xs uppercase tracking-[0.25em] text-white/60">Academic Window</p>
                        <p class="text-sm font-semibold text-white">{{ course.term.schoolYear }} · {{ course.term.termLabel }}</p>
                        <p class="text-xs text-white/70">{{ course.term.startDate|date('M d, Y') }} – {{ course.term.endDate|date('M d, Y') }}</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="rounded-3xl border border-gray-100 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-center gap-4">
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-lg font-semibold">{{ weeks|length }}</div>
                <div>
                    <p class="text-xs uppercase tracking-[0.35em] text-gray-400">Weekly cadence</p>
                    <p class="text-sm font-semibold text-gray-800">14 scheduled weeks of content</p>
                </div>
            </div>
            <div class="hidden h-10 w-px bg-gray-200 md:block"></div>
            <div class="flex items-center gap-3">
                <div class="h-10 w-10 rounded-2xl bg-slate-50 text-slate-700 flex items-center justify-center text-lg font-semibold">
                    {{ totalSubmissions }}
                </div>
                <div>
                    <p class="text-xs uppercase tracking-[0.35em] text-gray-400">Your uploads</p>
                    <p class="text-sm font-semibold text-gray-800">Track submitted assignments per week</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Weekly Materials Accordion ── #}
<section class="space-y-4">
    <div class="flex items-center justify-between">
        <div>
            <p class="text-xs uppercase tracking-[0.4em] text-gray-400">Weekly drops</p>
            <h2 class="text-lg font-semibold text-gray-900">Resources, announcements, and submissions</h2>
        </div>
        <p class="text-xs text-gray-400">Tap a week to expand details</p>
    </div>
    <div class="space-y-3">
{% for w in orderedWeekNumbers %}
    {% set week = weeks[w] is defined ? weeks[w] : null %}
    {% set hasMaterials = week and week.materials|length > 0 %}

        <div class="rounded-2xl border border-gray-100 bg-white shadow-sm overflow-hidden" data-week-card
            data-student-search-item
            data-student-search-text="{{ 'week ' ~ w ~ ' ' ~ (week ? week.title : '') ~ ' ' ~ (week and week.description ? week.description : '') }}">
        <button type="button"
                class="w-full flex items-center justify-between px-6 py-4 text-left transition hover:bg-gray-50"
                onclick="toggleWeek({{ w }})"
                aria-expanded="false"
                data-week-toggle="{{ w }}">
            <div class="flex items-center gap-4 min-w-0">
                <div class="flex h-10 w-10 items-center justify-center rounded-2xl text-sm font-semibold"
                     style="background-color:{% if hasMaterials %}#e8f2ea;color:#0b3612;{% else %}#f3f4f6;color:#6b7280;{% endif %};">
                    W{{ '%02d'|format(w) }}
                </div>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-gray-900 truncate">Week {{ w }}</p>
                    {% if week and week.title matches '/^Week \d+$/' == false %}
                        <p class="text-xs text-gray-500 truncate">{{ week.title }}</p>
                    {% endif %}
                    <p class="text-xs text-gray-400">{{ hasMaterials ? week.materials|length : 0 }} file{{ hasMaterials and week.materials|length != 1 ? 's' : '' }}</p>
                </div>
            </div>
            <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" data-week-chevron="{{ w }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
        </button>

        <div class="border-t border-gray-100 px-6 py-5 hidden" data-week-panel="{{ w }}">
            {% if hasMaterials %}
                <ul class="space-y-2">
                    {% for material in week.materials %}
                    {% set isUnlocked = unlockedMaterialIds[material.id]|default(true) %}
                    {% set isViewed = viewedMaterialIds[material.id]|default(false) %}
                    
                    {% set ext = material.filename|split('.')|last|lower %}
                    {% set isVideo = ext in ['mp4', 'webm', 'mov', 'mkv', 'avi'] %}
                    
                    <li class="flex items-center justify-between gap-3 px-4 py-3 rounded-xl border border-gray-100 hover:border-emerald-100 hover:bg-emerald-50/40 transition"
                        data-material-row
                        data-material-id="{{ material.id }}"
                        data-material-unlocked="{{ isUnlocked ? '1' : '0' }}"
                        data-student-search-item
                        data-student-search-text="{{ 'week ' ~ w ~ ' ' ~ material.originalName ~ ' ' ~ material.uploadedAt|date('M d, Y') ~ ' material file' }}">
                        <div class="flex items-center gap-3 min-w-0">
                            
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" 
                                 style="{% if isVideo %}background-color:#e0f2fe;color:#0369a1;{% else %}background-color:#ecfdf5;color:#0b3612;{% endif %}">
                                {% if isVideo %}
                                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                    </svg>
                                {% else %}
                                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                {% endif %}
                            </div>
                            
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span data-view-indicator class="inline-flex shrink-0 items-center justify-center rounded-full border"
                                          style="width:16px;height:16px;line-height:1;border-color:{{ isViewed ? '#059669' : '#d1d5db' }};background-color:{{ isViewed ? '#059669' : '#ffffff' }};color:{{ isViewed ? '#ffffff' : 'transparent' }};font-size:11px;font-weight:700;">
                                        {% if isViewed %}
                                            &#10003;
                                        {% endif %}
                                    </span>

                                    {% if isUnlocked %}
                                        <button type="button"
                                                data-mark-url="{{ path('app_student_material_mark_viewed', {id: material.id}) }}"
                                                data-file-url="{{ asset('uploads/materials/' ~ material.filename) }}"
                                                data-file-name="{{ material.originalName|e('html_attr') }}"
                                                data-file-type="{{ isVideo ? 'video' : 'pdf' }}"
                                                onclick="handleMaterialOpen(this)"
                                                class="text-sm font-medium text-gray-800 truncate text-left hover:text-emerald-700 hover:underline transition cursor-pointer">
                                            {{ material.originalName }}
                                        </button>
                                    {% else %}
                                        <p class="text-sm font-medium text-gray-800 truncate">{{ material.originalName }}</p>
                                    {% endif %}
                                    
                                    <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded tracking-wide shrink-0" 
                                          style="{% if isVideo %}background-color:#f0f9ff;color:#0369a1; border:1px solid #bae6fd;{% else %}background-color:#f0fdf4;color:#166534; border:1px solid #bbf7d0;{% endif %}">
                                        {{ isVideo ? ext|upper : 'PDF' }}
                                    </span>
                                </div>

                                <p class="text-xs text-gray-400">{{ material.uploadedAt|date('M d, Y') }}</p>
                                {% if not isUnlocked %}
                                    <p class="text-[11px] text-amber-700 font-medium">{{ materialLockReasons[material.id]|default('Locked until earlier requirements are completed.') }}</p>
                                {% endif %}
                            </div>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            {% if isUnlocked %}
                                <button type="button"
                                        data-material-open-button
                                        data-mark-url="{{ path('app_student_material_mark_viewed', {id: material.id}) }}"
                                        data-file-url="{{ asset('uploads/materials/' ~ material.filename) }}"
                                        data-file-name="{{ material.originalName|e('html_attr') }}"
                                        data-file-type="{{ isVideo ? 'video' : 'pdf' }}"
                                        onclick="handleMaterialOpen(this)"
                                        class="text-xs font-semibold px-3 py-1.5 rounded-lg text-white inline-flex items-center gap-1.5 transition cursor-pointer whitespace-nowrap"
                                        style="background-color:#0b3612;">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                    View
                                </button>
                            {% else %}
                                <button type="button"
                                        disabled
                                        class="text-xs font-semibold px-3 py-1.5 rounded-lg text-white inline-flex items-center gap-1.5 cursor-not-allowed whitespace-nowrap"
                                        style="background-color:#d1d5db;">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                    </svg>
                                    Locked
                                </button>
                            {% endif %}
                        </div>
                    </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-sm text-gray-400 py-2 text-center">No materials uploaded for this week yet.</p>
            {% endif %}

            {% if week and week.isSubmissionRequired %}
                <div class="mt-6 border-t border-gray-100 pt-5">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                            <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                            Assignment Submission
                        </h4>
                    </div>

                    <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
                        {% set weekSubmissions = submissionsByWeek[week.id] ?? [] %}
                        {% set totalUploaded = weekSubmissions|length %}
                        {% set maxFiles = week.maxFiles|default(1) %}
                        {% set canUploadMore = totalUploaded < maxFiles %}

                        <div class="flex items-center justify-between mb-6">
                            <div>
                                {% if totalUploaded > 0 %}
                                    <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-md text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                        Submitted ({{ totalUploaded }}/{{ maxFiles }})
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-md text-xs font-medium bg-yellow-50 text-yellow-800 border border-yellow-200">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                        Pending Submission
                                    </span>
                                {% endif %}
                            </div>
                            <div class="text-xs text-gray-500 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                {% if canUploadMore %}
                                    You can upload {{ maxFiles - totalUploaded }} more file{% if (maxFiles - totalUploaded) > 1 %}s{% endif %}
                                {% else %}
                                    Maximum files reached
                                {% endif %}
                            </div>
                        </div>

                        {% if totalUploaded > 0 %}
                            <div class="mb-6">
                                <h5 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">Your Files</h5>
                                <ul class="space-y-2.5">
                                    {% for sub in weekSubmissions %}
                                    <li class="flex flex-col gap-2 p-4 rounded-xl border border-gray-200 bg-white shadow-sm hover:border-emerald-100 hover:shadow-md transition"
                                        data-student-search-item
                                        data-student-search-text="{{ 'week ' ~ w ~ ' ' ~ (sub.originalName|default(sub.filename|default('Submission'))) ~ ' ' ~ sub.status ~ ' ' ~ (sub.grade is not null ? sub.grade : '') ~ ' ' ~ (sub.feedback ?: '') }}">
                                        <div class="flex items-center justify-between gap-3">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 {% if sub.status == 'graded' %}bg-green-50 text-green-700{% else %}bg-blue-50 text-blue-700{% endif %}">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                                    </svg>
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="text-sm font-medium text-gray-900 truncate">{{ sub.originalName|default(sub.filename|default('Submission')) }}</p>
                                                    <p class="text-xs text-gray-500 mt-0.5">Uploaded on {{ sub.uploadedAt|date('M d, Y \\a\\t h:i A') }}</p>
                                                </div>
                                            </div>
                                            <div class="shrink-0 flex items-center gap-2">
                                                {% if sub.status == 'graded' %}
                                                    <span class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full text-xs font-bold shadow-sm" style="background-color:#e8f2ea;color:#0b3612;">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                        Graded: {{ sub.grade }}
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full text-xs font-bold shadow-sm bg-yellow-100 text-yellow-800">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                        Pending
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                        {% if sub.status == 'graded' and sub.feedback %}
                                            <div class="mt-2 text-sm text-gray-700 bg-gray-50 p-3 rounded-md border border-gray-100">
                                                <span class="font-semibold text-xs text-gray-500 uppercase block mb-1">Professor Feedback</span>
                                                {{ sub.feedback|nl2br }}
                                            </div>
                                        {% endif %}
                                    </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <form action="{{ path('app_student_submission_upload', {courseId: course.id, weekId: week.id}) }}" method="POST" enctype="multipart/form-data" class="flex flex-col gap-4 {% if not canUploadMore %}opacity-50 pointer-events-none{% endif %}">
                            <div class="flex items-center justify-center w-full">
                                <label for="dropzone-file-{{ week.id }}" class="flex flex-col items-center justify-center w-full h-36 border-2 border-dashed rounded-xl cursor-pointer bg-white border-gray-200 hover:border-emerald-200 hover:bg-emerald-50/40 transition-all">
                                    <div class="flex flex-col items-center justify-center pt-5 pb-6 text-center px-4">
                                        <svg class="w-8 h-8 mb-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                                        </svg>
                                        <p class="mb-1 text-sm text-gray-600"><span class="font-semibold text-gray-800">Click to browse</span> or drag & drop</p>
                                        <p class="text-xs text-gray-400 mt-1">
                                            {% if week.allowedFileTypes and week.allowedFileTypes|length > 0 %}
                                                Accepts {{ week.allowedFileTypes|join(', ')|upper }}
                                            {% else %}
                                                Any file type accepted
                                            {% endif %}
                                        </p>
                                    </div>
                                    <input id="dropzone-file-{{ week.id }}" type="file" name="submission_files[]" class="hidden"
                                        {% if week.allowedFileTypes and week.allowedFileTypes|length > 0 %}
                                            {% set acceptParts = [] %}
                                            {% for type in week.allowedFileTypes %}
                                                {% if type == 'pdf' %}{% set acceptParts = acceptParts|merge(['.pdf', 'application/pdf']) %}{% endif %}
                                                {% if type == 'word' %}{% set acceptParts = acceptParts|merge(['.doc', '.docx', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']) %}{% endif %}
                                                {% if type == 'image' %}{% set acceptParts = acceptParts|merge(['image/*']) %}{% endif %}
                                            {% endfor %}
                                            accept="{{ acceptParts|join(',') }}"
                                        {% endif %}
                                        {% if maxFiles > 1 %}multiple{% endif %}
                                        {% if not canUploadMore %}disabled{% endif %}
                                    >
                                </label>
                            </div>

                            <button type="submit"
                                    class="text-sm font-semibold text-white px-5 py-2.5 rounded-xl transition w-full flex items-center justify-center gap-2 shadow-sm cursor-pointer bg-emerald-900 hover:bg-emerald-800"
                                    {% if not canUploadMore %}disabled{% endif %}>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                Upload & Submit
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>

    </div>
{% endfor %}
</div>
</section>

<div id="media-viewer-modal" class="fixed inset-0 z-50 hidden flex-col bg-black/70" onclick="if(event.target===this) closeMediaViewer()">
    <div class="mx-auto flex h-full w-full max-w-4xl flex-col rounded-none bg-white shadow-2xl">
        <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
            <div class="flex items-center gap-3 min-w-0">
                <div id="viewer-icon-container" class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
                </div>
                <span id="media-viewer-title" class="truncate text-sm font-semibold text-gray-900"></span>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="closeMediaViewer()" class="rounded-xl p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>
        <div class="flex-1 bg-gray-100 flex items-center justify-center overflow-hidden">
            <iframe id="media-viewer-frame" src="" class="h-full w-full border-none hidden"></iframe>
            
            <div id="media-video-container" class="w-full h-full max-h-full hidden bg-black flex items-center justify-center">
                <video id="media-video-player" controls controlsList="nodownload" class="w-full h-full object-contain">
                    Your browser does not natively support playing this specific video format inline.
                </video>
            </div>
        </div>
    </div>
</div>

<script>
function toggleWeek(n) {
    const panel = document.querySelector('[data-week-panel="' + n + '"]');
    const chevron = document.querySelector('[data-week-chevron="' + n + '"]');
    const toggle = document.querySelector('[data-week-toggle="' + n + '"]');
    if (!panel || !chevron || !toggle) {
        return;
    }

    const isHidden = panel.classList.contains('hidden');
    panel.classList.toggle('hidden');
    chevron.style.transform = isHidden ? 'rotate(180deg)' : '';
    toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
}

function openMediaViewer(url, name, type) {
    const modal = document.getElementById('media-viewer-modal');
    const titleEl = document.getElementById('media-viewer-title');
    const iconContainer = document.getElementById('viewer-icon-container');
    const iframe = document.getElementById('media-viewer-frame');
    const videoContainer = document.getElementById('media-video-container');
    const videoPlayer = document.getElementById('media-video-player');
    
    titleEl.textContent = name;
    
    iframe.classList.add('hidden');
    iframe.src = '';
    videoContainer.classList.add('hidden');
    videoPlayer.pause();
    videoPlayer.src = '';
    
    if (type === 'video') {
        iconContainer.className = "flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-700";
        iconContainer.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>`;
        
        videoPlayer.src = url;
        videoContainer.classList.remove('hidden');
        videoPlayer.load();
    } else {
        // Default to PDF / document icon
        iconContainer.className = "flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700";
        iconContainer.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`;
        
        iframe.src = url;
        iframe.classList.remove('hidden');
    }
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
}

async function handleMaterialOpen(button) {
    if (!button || button.disabled) {
        return;
    }

    const row = button.closest('[data-material-row]');
    const markUrl = button.dataset.markUrl;
    const fileUrl = button.dataset.fileUrl;
    const fileName = button.dataset.fileName || 'Module';
    const fileType = button.dataset.fileType || 'pdf';

    const body = new URLSearchParams();
    body.set('token', '{{ csrf_token('student-mark-material-view') }}');

    try {
        const response = await fetch(markUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: body.toString(),
        });

        const payload = await response.json();
        if (!response.ok || !payload.success) {
            const message = payload.message || 'This module is locked. Complete the previous module first.';
            if (typeof showToast === 'function') {
                showToast('error', message);
            } else {
                alert(message);
            }
            return;
        }

        row?.querySelector('.text-amber-700')?.remove();
        const indicator = row?.querySelector('[data-view-indicator]');
        if (indicator) {
            indicator.style.borderColor = '#059669';
            indicator.style.backgroundColor = '#059669';
            indicator.style.color = '#ffffff';
            indicator.innerHTML = '&#10003;';
        }

        openMediaViewer(fileUrl, fileName, fileType);
    } catch (error) {
        if (typeof showToast === 'function') {
            showToast('error', 'Unable to open this module right now.');
        }
    }
}

function closeMediaViewer() {
    const modal = document.getElementById('media-viewer-modal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    
    const iframe = document.getElementById('media-viewer-frame');
    iframe.src = '';
    iframe.classList.add('hidden');
    
    const videoPlayer = document.getElementById('media-video-player');
    videoPlayer.pause();
    videoPlayer.src = '';
    document.getElementById('media-video-container').classList.add('hidden');
    
    document.body.style.overflow = '';
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeMediaViewer();
});

document.addEventListener('DOMContentLoaded', function () {
    const firstToggle = document.querySelector('[data-week-toggle]');
    if (firstToggle) {
        toggleWeek(firstToggle.getAttribute('data-week-toggle'));
    }
});
</script>
{% endblock %}
