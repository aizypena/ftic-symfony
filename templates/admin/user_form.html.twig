{# templates/admin/user_form.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}
	{{ title }}
	– FTIC Admin
{% endblock %}

{% block body %}
	<div class="mb-6 flex items-center justify-between">
		<div>
			<h1 class="text-2xl font-bold text-gray-900">{{ title }}</h1>
			<p class="text-sm text-gray-500 mt-1">Fill in the details below</p>
		</div>
		<a href="{{ path('app_admin_users') }}" class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 px-4 py-2 rounded-lg border border-gray-200 bg-white hover:bg-gray-50 transition">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
			</svg>
			Back to Users
		</a>
	</div>

	{{ form_start(form, {attr: {class: 'space-y-6', novalidate: 'novalidate'}}) }}

	<div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 space-y-6">

		{# First / Last Name #}
		<div class="grid grid-cols-2 gap-4">
			<div>
				{{ form_label(form.firstName, 'First Name', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
				{{ form_widget(form.firstName, {attr: {
                class: 'w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 bg-gray-50' ~ (form.firstName.vars.valid ? '' : ' border-red-300 focus:ring-red-200'),
                placeholder: 'Juan'
            }}) }}
				{% if not form.firstName.vars.valid %}
					<div class="text-xs font-semibold text-red-600 mt-1.5 flex items-center gap-1">
						<span class="w-1 h-1 rounded-full bg-red-600"></span>
						{{ form_errors(form.firstName) }}
					</div>
				{% endif %}
			</div>
			<div>
				{{ form_label(form.lastName, 'Last Name', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
				{{ form_widget(form.lastName, {attr: {
                class: 'w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 bg-gray-50' ~ (form.lastName.vars.valid ? '' : ' border-red-300 focus:ring-red-200'),
                placeholder: 'dela Cruz'
            }}) }}
				{% if not form.lastName.vars.valid %}
					<div class="text-xs font-semibold text-red-600 mt-1.5 flex items-center gap-1">
						<span class="w-1 h-1 rounded-full bg-red-600"></span>
						{{ form_errors(form.lastName) }}
					</div>
				{% endif %}
			</div>
		</div>

		{# Email Address #}
		<div>
			{{ form_label(form.email, 'Email Address', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
			{{ form_widget(form.email, {attr: {
            class: 'w-full px-4 py-2.5 text-sm border rounded-lg focus:outline-none focus:ring-2 bg-gray-50' ~ (form.email.vars.valid ? ' border-gray-200 focus:ring-feu-light' : ' border-red-300 focus:ring-red-200 focus:border-red-400'),
            placeholder: 'user@example.com'
        }}) }}
			{# ── Stylized Custom Red Error Text Output ── #}
			{% if not form.email.vars.valid %}
				<div class="text-xs font-semibold text-red-600 mt-1.5 flex items-center gap-1 bg-red-50/50 px-2 py-1 rounded-md border border-red-100 w-fit">
					<svg class="w-3.5 h-3.5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
					</svg>
					{{ form_errors(form.email) }}
				</div>
			{% endif %}
		</div>

		{# Role #}
		<div>
			{{ form_label(form.role, 'Role', {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
			{{ form_widget(form.role, {attr: {
            class: 'w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 bg-gray-50' ~ (form.role.vars.valid ? '' : ' border-red-300 focus:ring-red-200')
        }}) }}
			{% if not form.role.vars.valid %}
				<div class="text-xs font-semibold text-red-600 mt-1.5 flex items-center gap-1">
					<span class="w-1 h-1 rounded-full bg-red-600"></span>
					{{ form_errors(form.role) }}
				</div>
			{% endif %}
		</div>

		{# Password #}
		<div>
			{{ form_label(form.plainPassword, null, {label_attr: {class: 'block text-sm font-medium text-gray-700 mb-1'}}) }}
			{{ form_widget(form.plainPassword, {attr: {
            class: 'w-full px-4 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 bg-gray-50' ~ (form.plainPassword.vars.valid ? '' : ' border-red-300 focus:ring-red-200')
        }}) }}
			{% if not form.plainPassword.vars.valid %}
				<div class="text-xs font-semibold text-red-600 mt-1.5 flex items-center gap-1">
					<span class="w-1 h-1 rounded-full bg-red-600"></span>
					{{ form_errors(form.plainPassword) }}
				</div>
			{% endif %}
			{% if editUser is defined %}
				<p class="mt-1 text-xs text-gray-400">Leave blank to keep the current password.</p>
			{% endif %}
		</div>

	</div>

	<div class="flex items-center gap-4">
		<button type="submit" class="inline-flex items-center gap-2 text-sm font-semibold text-white px-6 py-2.5 rounded-lg shadow-sm transition" style="background-color:#0b3612;" onmouseover="this.style.backgroundColor='#5c8d67'" onmouseout="this.style.backgroundColor:#0b3612' ">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
			</svg>
			Save User
		</button>
		<a href="{{ path('app_admin_users') }}" class="text-sm text-gray-500 hover:text-gray-700">Cancel</a>
	</div>

	{{ form_end(form) }}
{% endblock %}
