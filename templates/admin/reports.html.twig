{# templates/admin/reports.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Reports - FTIC Admin{% endblock %}

{% block body %}
    {# Need to configure asset mapper or webpack encore to use standard Chart.js integration #}
    {% block javascripts %}
        {{ parent() }}
    {% endblock %}

    <div class="space-y-8" data-admin-search-item data-admin-search-text="Reports & Analytics Dashboard Funnel Capacity Trends">
        
        {# Header & Controls #}
        <div class="flex items-center justify-between border-b border-gray-200 pb-5">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-gray-950">Reports & Analytics</h1>
                <p class="text-sm text-gray-500 mt-1">Operational data overview for the 1st Semester 2026-2027.</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    Export Data
                </button>
                <select class="pl-4 pr-10 py-2 text-sm font-medium text-white border border-transparent rounded-lg focus:outline-none focus:ring-2 focus:ring-feu-light focus:border-transparent" style="background-color:#0b3612;">
                    <option>1st Sem 2026-2027</option>
                    <option>2nd Sem 2025-2026</option>
                </select>
            </div>
        </div>

        {# KPIs #}
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Total Applications</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-gray-950">177</div>
                <p class="text-sm text-green-600 mt-1">↑ 12% vs last term</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Under Review</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-gray-950">45</div>
                <p class="text-sm text-gray-600 mt-1">AVG. 3.2 days</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Approval Rate</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-feu-dark">67.8%</div>
                <p class="text-sm text-feu-dark mt-1">120 Total Approved</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Rejected</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-red-700">12</div>
                <p class="text-sm text-red-600 mt-1">Missing requirements</p>
            </div>
        </div>

        {# Row 2: Status Breakdown & Application Funnel #}
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
            
            {# Application Funnel Chart (Placeholder) #}
            <div class="lg:col-span-2 bg-white p-7 rounded-2xl border border-gray-100 shadow-sm">
                <h3 class="text-lg font-semibold text-gray-950 mb-6">Application Submission Funnel</h3>
                <div class="h-80 w-full flex items-center justify-center border-2 border-dashed border-gray-200 rounded-xl bg-gray-50">
                    {# Chart.js will render here: a stylized bar chart or area chart showing timeline #}
                    <div class="text-center text-gray-500">
                        <svg class="w-12 h-12 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                        [Funnel / Timeline Chart Placeholder]
                    </div>
                </div>
            </div>

            {# Status Breakdown (Doughnut Placeholder) #}
            <div class="bg-white p-7 rounded-2xl border border-gray-100 shadow-sm flex flex-col">
                <h3 class="text-lg font-semibold text-gray-950 mb-6">Status Overview</h3>
                <div class="flex-1 flex flex-col items-center justify-center">
                    <div class="relative w-48 h-48 mb-6 border-2 border-dashed border-gray-200 rounded-full bg-gray-50 flex items-center justify-center">
                        {# Chart.js Doughnut Chart will render here #}
                        <div class="text-center">
                            <span class="text-4xl font-extrabold text-gray-950">177</span>
                            <span class="block text-sm text-gray-500">Total</span>
                        </div>
                    </div>
                    {# Dynamic Legend matching the FEU palette and status types #}
                    <div class="w-full grid grid-cols-2 gap-x-4 gap-y-2 text-sm text-gray-700">
                        <div class="flex items-center gap-2.5"><span class="w-3 h-3 rounded-full bg-green-500"></span> Approved (120)</div>
                        <div class="flex items-center gap-2.5"><span class="w-3 h-3 rounded-full bg-yellow-400"></span> Pending (45)</div>
                        <div class="flex items-center gap-2.5"><span class="w-3 h-3 rounded-full bg-red-500"></span> Rejected (12)</div>
                        <div class="flex items-center gap-2.5"><span class="w-3 h-3 rounded-full bg-blue-500"></span> Under Review (20)</div>
                    </div>
                </div>
            </div>
        </div>

        {# Row 3: Course Demand and Enrollment Trends #}
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            {# Top Courses by Application Volume #}
            <div class="bg-white p-7 rounded-2xl border border-gray-100 shadow-sm">
                <h3 class="text-lg font-semibold text-gray-950 mb-6">Top Programs by Application Volume</h3>
                <div class="space-y-4">
                    {% for course in [
                        {'name': 'BS Computer Science', 'code': 'BSCS', 'apps': 85, 'percent': 42},
                        {'name': 'BS Information Technology', 'code': 'BSIT', 'apps': 64, 'percent': 31},
                        {'name': 'BS Business Administration', 'code': 'BSBA', 'apps': 50, 'percent': 24},
                        {'name': 'BA Communication', 'code': 'BACOMM', 'apps': 10, 'percent': 5},
                    ] %}
                    <div class="relative">
                        <div class="flex items-center justify-between text-sm mb-1.5">
                            <span class="font-medium text-gray-900">{{ course.name }} ({{ course.code }})</span>
                            <span class="text-gray-600">{{ course.apps }} Apps ({{ course.percent }}%)</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2.5 overflow-hidden">
                            {# Using FEU dark green for the bars #}
                            <div class="h-full rounded-full" style="width: {{ course.percent }}%; background-color:#0b3612;"></div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>

            {# Enrollment Bottlenecks / Capacity Planning #}
            <div class="bg-white p-7 rounded-2xl border border-gray-100 shadow-sm">
                <h3 class="text-lg font-semibold text-gray-950 mb-6">Course Capacity Alerts</h3>
                <div class="border border-gray-100 rounded-xl overflow-hidden shadow-inner">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50 text-xs text-gray-600 uppercase tracking-wider">
                            <tr>
                                <th class="px-5 py-3">Course Code</th>
                                <th class="px-5 py-3">Capacity</th>
                                <th class="px-5 py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 text-gray-800">
                            <tr>
                                <td class="px-5 py-3.5 font-medium">CS101 - Intro Programming</td>
                                <td class="px-5 py-3.5">148/150 (99%)</td>
                                <td class="px-5 py-3.5"><span class="px-2.5 py-1 text-xs font-medium rounded-full bg-red-100 text-red-800">At Capacity</span></td>
                            </tr>
                            <tr>
                                <td class="px-5 py-3.5 font-medium">IT205 - Database Systems</td>
                                <td class="px-5 py-3.5">110/120 (92%)</td>
                                <td class="px-5 py-3.5"><span class="px-2.5 py-1 text-xs font-medium rounded-full bg-yellow-100 text-yellow-800">High Demand</span></td>
                            </tr>
                            <tr>
                                <td class="px-5 py-3.5 font-medium">BA301 - Marketing Principles</td>
                                <td class="px-5 py-3.5">45/100 (45%)</td>
                                <td class="px-5 py-3.5"><span class="px-2.5 py-1 text-xs font-medium rounded-full bg-green-100 text-green-800">Good Capacity</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
