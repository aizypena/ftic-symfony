{% extends 'admin/base.html.twig' %}

{% block title %}Reports - FTIC Admin{% endblock %}

{% block body %}
    <div class="space-y-8" data-admin-search-item data-admin-search-text="Reports & Analytics Dashboard Insights Enrollment Activities">
        
        {# Header & Controls #}
        <div class="flex items-center justify-between border-b border-gray-200 pb-5">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-gray-950">Reports & Analytics</h1>
                <p class="text-sm text-gray-500 mt-1">Institutional overview and engagement metrics for 1st Semester 2026-2027.</p>
            </div>
            <div class="flex items-center gap-3">
                <button type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition">
                    Export CSV
                </button>
                <select class="pl-4 pr-10 py-2 text-sm font-medium text-white border border-transparent rounded-lg focus:outline-none focus:ring-2 focus:ring-feu-light focus:border-transparent" style="background-color:#0b3612;">
                    <option>1st Sem 2026-2027</option>
                    <option>2nd Sem 2025-2026</option>
                </select>
            </div>
        </div>

        {# ── NEW: Key Insights Section ── #}
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5 shadow-sm">
            <h3 class="text-sm font-semibold text-amber-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
                Key Insights & Administrative Alerts
            </h3>
            <ul class="mt-3 text-sm text-amber-800 space-y-2 list-disc list-inside">
                <li><strong class="font-medium text-amber-950">High Platform Adoption:</strong> Professors have deployed a combined total of <span class="font-semibold">248 active activities</span> across all handling sections this term.</li>
                <li><strong class="font-medium text-amber-950">Capacity Bottleneck:</strong> <span class="font-semibold">BSCS</span> courses have reached <span class="font-semibold">94% enrollment capacity</span>, indicating high demand for upcoming terms.</li>
                <li><strong class="font-medium text-amber-950">Action Item:</strong> 2 courses currently have zero created activities. A follow-up notification may be required for assigned faculty members.</li>
            </ul>
        </div>

        {# High-Level KPIs #}
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Total Enrolled Students</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-gray-950">1,240</div>
                <p class="text-sm text-green-600 mt-1">↑ 8.4% vs last semester</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Total Activities Created</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-gray-950">248</div>
                <p class="text-sm text-gray-600 mt-1">Quizzes, Tasks & Exams</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Pending Applications</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-feu-dark">45</div>
                <p class="text-sm text-feu-dark mt-1">Awaiting evaluation</p>
            </div>
            <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-sm">
                <div class="text-sm font-medium text-gray-500 truncate">Active Faculty (Professors)</div>
                <div class="mt-2 text-4xl font-bold tracking-tight text-gray-950">38</div>
                <p class="text-sm text-green-600 mt-1">92% System Activity Rate</p>
            </div>
        </div>

        {# Detailed Breakdown: Enrollment and Faculty Activities #}
        <div class="bg-white p-7 rounded-2xl border border-gray-100 shadow-sm">
            <div class="mb-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                    <h3 class="text-lg font-semibold text-gray-950">Course Performance & Activity Audit</h3>
                    <p class="text-sm text-gray-500 mt-0.5">Audit tracking of student counts and instructional assets across departments.</p>
                </div>
            </div>
            
            <div class="border border-gray-100 rounded-xl overflow-hidden shadow-inner">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-50 text-xs text-gray-600 uppercase tracking-wider border-b border-gray-100">
                        <tr>
                            <th class="px-6 py-3.5">Course & Program</th>
                            <th class="px-6 py-3.5">Students Enrolled</th>
                            <th class="px-6 py-3.5">Number of Activities</th>
                            <th class="px-6 py-3.5">Status Indicator</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-800">
                        <tr>
                            <td class="px-6 py-4">
                                <div class="font-semibold text-gray-950">CS101 - Intro to Programming</div>
                                <div class="text-xs text-gray-400">BSCS Core</div>
                            </td>
                            <td class="px-6 py-4 font-medium">142 Students</td>
                            <td class="px-6 py-4 text-gray-600">32 Tasks / 8 Quizzes</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-full bg-green-50 text-green-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Active Engagement
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4">
                                <div class="font-semibold text-gray-950">IT205 - Database Systems</div>
                                <div class="text-xs text-gray-400">BSIT Requirement</div>
                            </td>
                            <td class="px-6 py-4 font-medium">118 Students</td>
                            <td class="px-6 py-4 text-gray-600">14 Tasks / 4 Quizzes</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-full bg-green-50 text-green-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Active Engagement
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4">
                                <div class="font-semibold text-gray-950">RE003 - Web Application Dev</div>
                                <div class="text-xs text-gray-400">Elective Track</div>
                            </td>
                            <td class="px-6 py-4 font-medium">45 Students</td>
                            <td class="px-6 py-4 text-gray-600 font-semibold text-amber-700">2 Tasks / 0 Quizzes</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-full bg-amber-50 text-amber-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Low Activity
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td class="px-6 py-4">
                                <div class="font-semibold text-gray-950">FEU102 - Institutional History</div>
                                <div class="text-xs text-gray-400">General Education</div>
                            </td>
                            <td class="px-6 py-4 font-medium">310 Students</td>
                            <td class="px-6 py-4 text-red-700 font-bold">0 Active Activities</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-full bg-red-50 text-red-800">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Action Required
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
{% endblock %}
